<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WP 4b.2: the API client talks to vault-api over HTTP(S). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- WP 4b.8: runtime-requested on API 33+ (Settings screen, see
         SettingsScreen.kt's Notifications section); below API 33 this
         permission does not gate anything and notify() just works subject
         to the user's Settings toggle. NotificationPollWorker still runs
         (and still updates the persisted snapshot) if this is denied — only
         the visible notification is skipped, per AndroidNotificationPoster's
         kdoc. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup is deliberately false: this app stores the vault-api
         key (and the Steam identity) in its private storage —
         storage/EncryptedCredentialStore.kt, since WP 4b.2. Auto Backup
         (android:allowBackup="true", the default) would ship that key to
         the user's cloud backup / off-device on uninstall+reinstall — the
         same class of leak the WP 4b.1 review flagged before any secret
         actually exists here, so the setting is correct from the first
         commit rather than retrofitted later. dataExtractionRules is the
         Android 12+ counterpart: allowBackup alone only governs cloud
         backup on API 31+, not device-to-device transfer, which needs its
         own exclusion (res/xml/data_extraction_rules.xml). -->
    <application
        android:name=".VaultApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SteamVault"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SteamVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- WP 4b.3: Steam OpenID login callback. dev.steamvault.app.net.steam.SteamOpenIdConfig's
                 RETURN_TO/REALM constants must stay in sync with this
                 scheme/host/path; see that object's kdoc for why a custom
                 scheme (not an https:// return_to) was chosen.
                 android:launchMode="singleTask" above so Valve's redirect
                 delivers into MainActivity.onNewIntent on the app's
                 EXISTING task/instance instead of spawning a second one
                 (the standard pattern for a single-activity OAuth/OpenID
                 callback). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="steamvault"
                    android:host="auth"
                    android:path="/openid-return" />
            </intent-filter>
        </activity>
    </application>

</manifest>
