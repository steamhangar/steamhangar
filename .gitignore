# private planning doc — lives in Forgejo, never in this repo
steamvault_projektplan.md

# local env -- pattern has no slash, so it matches .env at ANY depth
# (api/.env, deploy/.env, ...). Only the committed *.env.example templates
# ever enter the repo.
.env

# Phase 0 PoC (poc/) — throwaway artifacts, never committed
poc/nginx/
poc/cache/
poc/logs/
poc/*.zip
poc/steamprefill/bin/
poc/steamprefill/app.log
poc/linux-client-test/wsl-env
poc/linux-client-test/_testkit_tmp/
poc/linux-client-test/_testkit_tmp_detect/

# vault-core (core/) — runtime artifacts of running nginx natively for dev/
# test (WP 1.1). The nginx binary itself is reused from poc/nginx/ (already
# gitignored above), never duplicated here.
core/cache/
core/logs/
core/tmp/
core/*.pid
core/_testcore_tmp/

# WP 1.7 MVP end-to-end test -- throwaway DB + uvicorn stdout/stderr logs for
# each run; RESULTS-*.md next to it IS committed evidence, this is not.
core/tests/mvp/_run_tmp/


# Claude Code harness artifacts
.claude/scheduled_tasks.lock

.claude/settings.local.json

# vault-api (api/) — Python virtualenv and runtime artifacts (WP 1.2)
api/.venv/
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm
.pytest_cache/

# vault-dns (dns/) — rendered test config, created and cleaned up by
# dns/tests/test-dnsmasq-config.ps1 (WP 1.8); only survives a crashed run.
dns/tests/_tmp/

# vault-agent Go port (agent/go/, WP 2.1b, ADR-0005) — cross-compiled agent
# binaries are build output, never committed; only agent/go/go.mod,
# go.sum (if any deps are added later), and *.go source are tracked. The
# Python reference implementation (agent/vault_agent/, its venv, its
# pytest.ini/requirements-dev.txt) was removed at the Phase-2 close-out
# (WP 2.6, ADR-0005 addendum) — its entries are gone from here too.
agent/go/*.exe
agent/go/**/*.exe
agent/go/vault-agent
agent/go/vault-agent.exe
# `go test -c` compiled test binaries, any nesting depth.
agent/go/**/*.test

# deploy/ (WP 1.9) — deploy/.env is already covered by the .env rule at the
# top. deploy/VERIFICATION-*.md is deliberately NOT ignored: like poc/RESULTS-*,
# it is committed evidence of a real container run.

# Android app release-signing secrets (WP 4b.9, app/app/build.gradle.kts).
# app/.gitignore already covers keystore.properties/*.jks/*.keystore/*.p12/
# *.pfx/*.bks scoped to app/ (where the signing config actually reads
# `keystore.properties` from, via `rootProject.file(...)` = app/keystore
# .properties) -- this root-level rule is belt-and-suspenders for the same
# filename accidentally created at the repo root instead (a no-slash
# pattern matches at any depth, same reasoning the .env rule above already
# documents).
keystore.properties



# WP DIST-1a: release files staged here by publish.yml before the vault-api
# image build; only the placeholder README is tracked.
api/dist/*
!api/dist/README.md
