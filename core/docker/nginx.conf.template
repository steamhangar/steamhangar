# SteamHangar vault-core — CONTAINER nginx config TEMPLATE (Phase 1, WP 1.9).
#
# ############################################################################
# # THIS FILE IS A NEAR-VERBATIM COPY OF core/nginx/nginx.conf.              #
# #                                                                          #
# # Only the directive lines enumerated in core/docker/check-config-drift.sh #
# # may differ (six kinds today), and they are all container-runtime         #
# # plumbing (log destinations, pid file, worker user, resolver and event-   #
# # log placeholders). Every other directive MUST stay byte-identical to     #
# # core/nginx/nginx.conf, which is the reviewed, test-covered source of     #
# # truth for the cache behaviour (ADR-0001 requirements 1-4).               #
# #                                                                          #
# # That contract is MACHINE-CHECKED, not a promise:                         #
# #     core/docker/check-config-drift.sh                                    #
# # strips comments/blank lines from both files, un-applies the enumerated   #
# # substitutions, and diffs the result. Any other divergence fails.         #
# # Run it after touching either file.                                       #
# ############################################################################
#
# The allowed differences (container form  <-  native dev form); the list
# in check-config-drift.sh is authoritative, this one is for the reader:
#   1. user nginx;                    <-  (absent; nginx's compile-time default)
#   2. pid /var/run/nginx.pid;        <-  pid logs/nginx.pid;
#   3. error_log /dev/stderr warn;    <-  error_log logs/error.log warn;
#   4. resolver ${VAULT_RESOLVER} ... <-  resolver 1.1.1.1 ...
#   5. access_log /dev/stdout vault;  <-  access_log logs/access.log vault;
#   6. access_log ${VAULT_EVENT_LOG} vault_event ...  <-  access_log logs/event.log vault_event ...
#
# NOT a delta (WP TH-1a): `include vault-upstream-rate.conf;` is the same
# line in both files. What differs is the FILE it names -- rendered at start
# by 27-vault-upstream-rate.sh here, static and uncapped natively; the
# drift check pins the line and asserts the static file equals the cap-off
# render.
#
# --- Rendering (${VAULT_RESOLVER}) ------------------------------------------
# This file is NOT read by nginx directly. It is installed at
# /etc/nginx/templates/nginx.conf.template and rendered to /etc/nginx/nginx.conf
# at container start by the official nginx image's own envsubst mechanism
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) with:
#     NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx
#     NGINX_ENVSUBST_FILTER=^VAULT_
# ^VAULT_ means "only ${VAULT_*} placeholders are touched" — and this file
# contains exactly one of those, ${VAULT_RESOLVER}.
#
# What that filter is actually for, measured rather than assumed: with the
# image's stock environment it changes nothing — rendering with and without it
# yields a byte-identical nginx.conf. The entrypoint builds its envsubst
# allowlist from environment variables that EXIST, and none of them is named
# like one of this file's nginx runtime variables ($uri, $host, $document_root,
# $upstream_status, ...); envsubst is case-sensitive, nginx's variables are
# lowercase, env vars are conventionally uppercase.
# The filter earns its place against a FUTURE lowercase env var colliding with
# one of those names. Unfiltered, envsubst would substitute that nginx variable
# with the env var's VALUE — not blank it — so the result stays syntactically
# valid, `nginx -t` still passes, and the cache quietly behaves differently.
# The filter is the only thing in this stack that would catch it, which is why
# it must not be "simplified away" just because removing it looks harmless.
# /docker-entrypoint.d/40-vault-preflight.sh re-asserts after rendering that no
# ${VAULT_...} placeholder survived, so a filter/env misconfiguration fails the
# container instead of starting nginx with a half-rendered config.
#
# --- Logging / log rotation (closes core/README.md's open caveat) -----------
# Both logs go to the container's stdout/stderr, so `docker logs` shows them and
# the json-file logging driver owns rotation (max-size/max-file are set on every
# service in deploy/compose.yaml). No logrotate, no SIGUSR1 reopen dance, no log
# volume, and no unbounded file growth inside the container. See
# deploy/README.md ("Logs and rotation") for the numbers and how to change them.
#
# --- Prefix / volume layout -------------------------------------------------
# The container runs nginx with `-p /vault`, so this file's relative paths
# resolve as:
#     root cache            ->  /vault/cache      (depot tree: /vault/cache/depot/<id>/...)
#     proxy_temp_path tmp/  ->  /vault/tmp/proxy
# /vault is ONE volume, which is what satisfies the binding same-filesystem
# requirement below (proxy_store finishes by rename()-ing from tmp/ into
# cache/). 40-vault-preflight.sh compares st_dev of the two directories at every
# start and refuses to boot if someone split them across two mounts.

user  nginx;
worker_processes  1;

pid        /var/run/nginx.pid;
error_log  /dev/stderr warn;

events {
    worker_connections  1024;
}

http {
    default_type  application/octet-stream;
    sendfile      on;

    # Pre-freeze review N5: no nginx version in the Server header or on
    # error pages. Costs nothing, removes a free fingerprint for anyone
    # probing port 80 on the LAN.
    server_tokens off;

    # nginx initializes all of these standard temp paths at startup
    # regardless of whether the corresponding module is actually exercised
    # by this config (same as the PoC) -- they must exist under the prefix.
    #
    # S3 FIX (found in review): these live under "tmp/", a SIBLING of the
    # "cache" document root -- not "cache/tmp/..." as in an earlier revision.
    # "cache/tmp/..." was web-reachable: an in-flight proxy_store temp file
    # (e.g. a partially-downloaded chunk, or one belonging to a request that
    # got rejected by the Host allowlist after the temp file was already
    # opened) sat under the same root nginx serves /depot/... from, so
    # GET /tmp/proxy/<tempname> could serve its raw, possibly-incomplete
    # bytes to any client that guessed/observed a temp filename -- reviewer
    # reproduced this. Moving temp storage outside "root" removes the
    # request-path overlap entirely: no URI this server accepts maps onto
    # "tmp/...", so there is nothing for a client request to resolve to.
    #
    # SAME-FILESYSTEM REQUIREMENT: "tmp/" must stay on the same filesystem
    # (same disk/volume) as "cache/" -- proxy_store finishes a download by
    # rename()-ing the temp file into its final path under cache/depot/...,
    # which is atomic and instant only when both paths are on one
    # filesystem. Across filesystems, rename() fails and nginx falls back to
    # a full copy (slower, and briefly doubles disk usage for large files).
    # IN THIS CONTAINER both resolve under the single /vault volume, and
    # /docker-entrypoint.d/40-vault-preflight.sh compares their st_dev at
    # every start -- a deployment that mounts cache/ and tmp/ from two
    # different volumes fails loudly at boot instead of silently degrading.
    client_body_temp_path tmp/client_body;
    fastcgi_temp_path     tmp/fastcgi;
    uwsgi_temp_path       tmp/uwsgi;
    scgi_temp_path        tmp/scgi;

    # ADR req 4: resolve upstream hostnames ourselves, at request time, over
    # the network -- never via the OS resolver/hosts file (see loop-safety
    # note in core/nginx/nginx.conf). valid=30s is deliberately short (vs.
    # the PoC's 300s): a dead upstream IP should stop being handed out again
    # reasonably soon after a failover (Phase 0 observed real 42s stalls /
    # 502 waves from a transient upstream-IP outage --
    # poc/linux-client-test findings).
    #
    # CONTAINER DELTA: the address is ${VAULT_RESOLVER}, rendered by envsubst
    # at container start (default 1.1.1.1 -- ENV in core/Dockerfile, override
    # via deploy/.env). Homelabs that must not send DNS to Cloudflare (or that
    # run a split-horizon resolver) can point this at their own. The value is
    # substituted VERBATIM into this config, so 40-vault-preflight.sh
    # validates it is a plain IP-address list (digits/dots/colons/spaces)
    # before nginx ever reads it -- a value containing ';' or '{' would
    # otherwise be nginx-config injection.
    #
    # It must NOT be pointed at vault-dns: vault-dns answers
    # *.steamcontent.com with vault-core's own address, which would make
    # vault-core proxy every miss back into itself (an infinite loop). Use a
    # real upstream resolver here. This is documented in deploy/README.md.
    resolver ${VAULT_RESOLVER} ipv6=off valid=30s;
    # Pre-freeze review P1: nginx's default resolver_timeout is 30s. With
    # an unreachable resolver every MISS would hang the client for that
    # long before the 502 -- longer than the whole proxy_connect_timeout /
    # proxy_next_upstream_timeout budget below. 5s keeps a resolver outage
    # in the same "fast, bounded failure" class as an upstream outage.
    resolver_timeout 5s;

    # One of the map value strings below (the upstream-edge fallback
    # hostname) is longer than nginx's default map_hash_bucket_size on this
    # platform; bump it so map_hash builds cleanly instead of failing at
    # startup with "could not build map_hash, you should increase
    # map_hash_bucket_size".
    map_hash_bucket_size 128;

    # --- Host-header allowlist + upstream host (ADR req 4 abuse guard) -----
    # Only these two hostname families are legitimate Steam CDN edges. This
    # is what stops this server being usable as a generic open HTTP proxy
    # via a forged Host header -- see the "Host-header allowlist" test in
    # core/tests/test-core.ps1 and the SEC-FIX-1 probes in
    # .github/scripts/verify-core-nginx.sh.
    #
    # Keyed on $host, not $http_host (nitpick fixed in review): $host is
    # nginx's normalized view of the effective hostname -- lowercased and
    # with any ":port" suffix already stripped, falling back to server_name
    # when no Host header is sent at all. $http_host is the raw header
    # verbatim. Using $host here means a client sending e.g.
    # "Host: Cache2-AMS1.SteamContent.COM:80" is matched/forwarded the same
    # as the canonical lowercase, portless form, instead of the allowlist
    # regex and the upstream connection target silently disagreeing on what
    # was actually sent. nginx also drops ONE trailing dot from $host, so a
    # client sending the fully-qualified "cache2-ams1.steamcontent.com."
    # matches without a pattern of its own (measured, SEC-FIX-1).
    #
    # SEC-FIX-1 (WP 5.3 review U-1): ONE map is the allowlist AND the
    # upstream host. Before, the allowlist was a separate map with
    # suffix-only patterns (`~*\.steamcontent\.com$`), and the upstream map
    # passed $host through verbatim for everything. Any Host ENDING in a
    # Steam suffix passed, e.g. "127.0.0.1?x.steamcontent.com", and
    # proxy_pass splits its URL at "?" and would dial 127.0.0.1. nginx
    # 1.29.8 happens to reject "?", "@", "#", "\", " " and "/" in a Host
    # with 400 before this map runs (measured); "%" and "_" did get
    # through and were allowed, which only ever led to a DNS lookup inside
    # Valve's own zone. Now:
    #   - each family is a FULL match of a strict hostname charset:
    #     dot-separated labels of [a-z0-9-] only, anchored at both ends, so
    #     no URL delimiter, percent sign, underscore, empty label or bare
    #     apex can match. (`$` could also match before a final newline;
    #     nginx refuses any control byte in a Host, so $host never has
    #     one.)
    #   - the value is $host itself, so a request for
    #     Host: cache2-ams1.steamcontent.com still reaches that real edge
    #     instead of one hardcoded upstream, and $vault_upstream_host is
    #     either a name one of these patterns fully matched, the fixed
    #     fallback edge below, or EMPTY. It can never carry an unvalidated
    #     name.
    #   - $vault_host_allowed is derived from it (empty = refused), so the
    #     guard in @miss and the name proxy_pass dials cannot disagree.
    #
    # Exception: "lancache.steamcontent.com" has no public A record (see
    # the loop-safety note in
    # core/nginx/nginx.conf) -- a client that resolved this server via the
    # hosts-file mode's marker hostname sends exactly this Host. Falling
    # back to a concrete, known-good Valve CDN edge here is the "safe
    # fallback default edge" required by ADR req 4. An exact string beats
    # every regex in an nginx map, so this entry wins over the
    # steamcontent.com pattern.
    map $host $vault_upstream_host {
        default                                             "";
        "lancache.steamcontent.com"                         dist-fra1.discovery.steamserver.net;
        "~*^[a-z0-9-]+(\.[a-z0-9-]+)*\.steamcontent\.com$"  $host;
        "~*^[a-z0-9-]+(\.[a-z0-9-]+)*\.steamserver\.net$"   $host;
    }

    map $vault_upstream_host $vault_host_allowed {
        default  1;
        ""       0;
    }

    # --- Store-only-200 guard (ADR req 2) -----------------------------------
    # See core/README.md "Store guard" for the full reasoning and the
    # empirical verification transcript (what nginx's proxy_store actually
    # does, guarded and unguarded, on this build).
    #
    # BLOCKER FIX (found in review): $upstream_status is not always a bare
    # status code. When proxy_next_upstream retries a failed attempt against
    # a second backend, nginx sets $upstream_status to a comma-separated list
    # of every attempt in order, e.g. "502, 200" for a failed-then-succeeded
    # retry -- confirmed against real Phase-0 evidence (poc/logs/access.log
    # lines 3391-3392: `upstream_status=502, 200`) and reproduced in an
    # isolated two-backend rig during this fix. A map keyed on the bare
    # literal "200" does NOT match "502, 200" -- it falls through to
    # `default ""`, silently discarding a completely valid, fully-received
    # 200 body instead of storing it. The `"~, 200$"` regex entry below
    # catches exactly this case: any status list whose LAST attempt (the one
    # that actually produced the response body we're about to send) was 200.
    map $upstream_status $vault_store_path {
        200          "$document_root$uri";
        "~, 200$"    "$document_root$uri";
        default      "";
    }

    # --- nocache=1 bypass (ADR req 3) ---------------------------------------
    # SteamPrefill (and LanCache-aware clients generally) append ?nocache=1
    # as a cache-busting speed probe and expect it to be served fresh, not
    # from the stored copy (poc/steamprefill/RESULTS-STEAMPREFILL-*.md).
    # try_files resolves against $uri, which already has the query string
    # stripped -- so left alone, a nocache=1 request for an already-cached
    # object would still HIT. This map forces try_files onto a path that can
    # never exist on disk whenever ?nocache=1 is present, so it always falls
    # through to @miss (real upstream fetch) regardless of what's cached.
    # Chosen semantics: the fresh body is then stored at the object's normal
    # canonical path via the same $vault_store_path guard above (only if the
    # fresh fetch is itself a 200), i.e. a nocache=1 hit REFRESHES the stored
    # copy rather than deleting it -- this is what proxy_store naturally
    # does when writing to the same path again, and is explicitly allowed
    # ("acceptable") by ADR req 3.
    map $arg_nocache $vault_try_target {
        default  $uri;
        "1"      "/__steamhangar_force_miss__$uri";
    }

    # "-" for upstream_status on locally-served cache hits (no upstream was
    # contacted), the real code otherwise. Unchanged from the PoC.
    map $upstream_status $vault_upstream_status {
        ""      "-";
        default $upstream_status;
    }

    # --- Upstream rate cap (WP TH-1a, core/README.md "Upstream rate cap") ---
    # Defines $vault_upstream_rate, consumed by proxy_limit_rate in @miss.
    # Relative include = resolved against this file's own directory (nginx's
    # conf prefix): core/nginx/vault-upstream-rate.conf natively (a static
    # "no cap" file), /etc/nginx/vault-upstream-rate.conf in the container,
    # rendered at start by /docker-entrypoint.d/27-vault-upstream-rate.sh from
    # VAULT_UPSTREAM_RATE / VAULT_UPSTREAM_RATE_WINDOW. The line itself is
    # identical in both files; check-config-drift.sh pins it and asserts the
    # native file equals the script's cap-off render.
    include vault-upstream-rate.conf;

    # --- Cache-event log (WP 3.10, ADR-0008) --------------------------------
    # A second, dedicated, machine-readable access_log alongside the existing
    # human-oriented "vault" log below. ADR-0008 explains WHY this exists
    # (feeding WP 3.11's miss-triggered prefill + per-client bypass stats
    # without making vault-core depend on vault-api being alive) -- this
    # comment documents the FORMAT and the empirically-verified decisions
    # behind it; core/README.md has the field table + evidence in one place.
    #
    # Format: tab-separated, one line per logged request, escape=default
    # (see the escaping note below), version-prefixed so a future format
    # change can be told apart from v1 instead of silently misparsed:
    #
    #   v1 <TAB> time_iso8601 <TAB> remote_addr <TAB> cache_status <TAB>
    #      depot_id <TAB> uri_path(<=300 chars) <TAB> bytes_sent <TAB> host
    #      <TAB> status
    #
    # REVIEW FINDING N3 (post-implementation, pre-first-consumer): $status
    # was added as a 9th field, appended after host. The version stays "v1"
    # rather than bumping -- nothing has ever consumed this format (WP 3.11
    # does not exist yet), so v1's definition changes in place here; the
    # version field exists to protect against FUTURE changes once a
    # consumer exists, not this one. See "9. status" below for why the
    # field exists.
    #
    # 1. version       -- literal "v1". WP 3.11's sweeper MUST reject any
    #    line whose first field isn't exactly "v1" rather than guessing at
    #    a changed field layout -- the whole reason this is its own field
    #    instead of implicit in the file format/name.
    # 2. time_iso8601  -- $time_iso8601 (e.g. 2026-08-09T14:03:11+02:00).
    # 3. remote_addr   -- $remote_addr, the direct TCP peer (no
    #    X-Forwarded-For trust -- vault-core is never deployed behind
    #    another proxy, docs/PROJECT_PLAN.md's deployment model).
    # 4. cache_status  -- HIT / MISS / BYPASS. See $vault_event_status below
    #    for why this is its own map fed by the location-scoped
    #    $vault_cache_status marker, never by $upstream_status.
    # 5. depot_id      -- digits captured from a /depot/<id>/... URI, or "-"
    #    (see $vault_event_depot below).
    # 6. uri_path      -- $uri (decoded, normalized, query string already
    #    stripped by nginx itself), bounded to 300 characters BEFORE
    #    log-format escaping can inflate it (see $vault_event_uri below).
    # 7. bytes_sent    -- $bytes_sent (total bytes written to the client,
    #    headers included -- same variable/semantics as the existing
    #    "vault" log's bytes_sent field, kept for consistency across both
    #    logs rather than switching to $body_bytes_sent here).
    # 8. host          -- $host (lowercased, port-stripped, same
    #    normalization the Host-allowlist map above already relies on).
    # 9. status        -- $status, the HTTP response status code. Without
    #    it, hit statistics would count a 403 (Host-allowlist rejection),
    #    404, or 502 the same as a genuinely served object -- cache_status
    #    alone says HIT/MISS/BYPASS but says nothing about whether the
    #    response actually succeeded, and bytes_sent (field 7) includes
    #    error-body bytes too. WP 3.11's sweeper needs to filter to 2xx/206
    #    before treating a line as "served traffic" for stats or as
    #    evidence a depot is now cached.
    #
    # --- Escaping: escape=default, deliberately not escape=json -----------
    # This is a TSV, not a JSON-lines file: json escaping dialect
    # (\u00XX, JSON-specific quoting) buys a byte-oriented tab-split parser
    # nothing and makes the field-count guarantee below harder to reason
    # about than it needs to be. escape=default does exactly what a
    # tab-separated format needs: it escapes control characters
    # (0x00-0x1F, 0x7F) -- INCLUDING a literal tab or newline that ends up
    # inside a decoded $uri via percent-encoding (e.g. a hostile path
    # containing %09 or %0A) -- as a printable \xXX sequence, and escapes a
    # literal `"` and `\` the same way. That is exactly the property this
    # format depends on: the only real tab bytes on the line are the
    # literal ones nginx inserts BETWEEN fields from the log_format string
    # itself, never from a variable's content, so a naive
    # `line.split("\t")` in WP 3.11's sweeper always gets exactly 8 fields
    # no matter what a client sends. PINNED by a dedicated hostile-URI test
    # (core/tests/test-core.ps1) that sends %09/%0A/%22/%C3%A9 inside a
    # request path and asserts the resulting event-log line still splits
    # into exactly 8 tab-separated fields with field 1 == "v1".
    #
    # --- depot id extraction ------------------------------------------------
    # Bounded ([0-9]+ only, anchored at the URI start) on purpose -- the
    # same digits-only discipline LEARNINGS calls out for any value that
    # will later feed a lookup/SQL query (WP 1.6/2.1). A depot id here only
    # ever becomes a dict/SQL key in WP 3.11, but treating it as untrusted
    # input costs nothing and avoids re-deriving the same lesson later.
    map $uri $vault_event_depot {
        default                         "-";
        "~^/depot/(?<depot_id>[0-9]+)/" $depot_id;
    }

    # Bounds the logged URI to 300 characters of the DECODED path (query
    # string already excluded by $uri itself) -- a defensive cap against an
    # abusive/hostile request path blowing up a single log line, independent
    # of nginx's own request-line size limits (large_client_header_buffers)
    # which bound the REQUEST, not this field. Unanchored at the end on
    # purpose: `{1,300}` is greedy and simply captures as much as is
    # available, up to 300 chars. $uri always starts with "/" and is
    # therefore always at least 1 character, so `default` below is
    # unreachable in practice and kept only as a defensive fallback.
    #
    # BLOCKER FIX (found empirically by this WP's own hostile-URI test):
    # PCRE's `.` does NOT match a newline by default. A path containing a
    # percent-encoded newline (%0A), decoded by nginx into a literal 0x0A
    # byte inside $uri BEFORE this map ever runs, made the greedy `.{1,300}`
    # match stop dead at that byte -- silently truncating everything after
    # it (not just the newline itself) instead of capturing it for
    # escape=default to turn into a visible `\x0A` later. `(?s)` (PCRE's
    # inline DOTALL modifier) makes `.` match newlines too, so the bound is
    # a true 300-character cap regardless of embedded control bytes, and
    # escape=default gets the full, unmangled content to escape.
    map $uri $vault_event_uri {
        default                          "";
        "~^(?s)(?<bounded_uri>.{1,300})" $bounded_uri;
    }

    # --- Cache-status truth: reuse the location-scoped marker, not
    # $upstream_status, and NOT $upstream_cache_status ----------------------
    # $upstream_status becomes a comma-separated retry list on a
    # proxy_next_upstream retry (LEARNINGS, e.g. "502, 200") -- a status
    # field fed directly from it would need the same "~, 200$"-style
    # last-attempt parsing the store-guard map above already does, and even
    # then would only describe the upstream HTTP status, not "was this
    # object served from local disk or fetched". $upstream_cache_status
    # does not apply here either -- MEASURED, not assumed: this config uses
    # proxy_store, never proxy_cache, and an empirical check during this
    # work package (core/tests/test-core.ps1) confirmed $upstream_cache_status
    # is the literal string "-" (nginx's documented "not configured" value)
    # on BOTH the try_files-HIT path (no upstream module ever invoked) and
    # the proxy_store MISS path -- it carries no HIT/MISS information at
    # all in this config, confirming the ADR's warning that it "does NOT
    # apply to proxy_store setups".
    #
    # $vault_cache_status (set explicitly via `set` in location /depot/ and
    # location @miss below) is immune to both problems: it reflects WHICH
    # LOCATION BLOCK actually served the request -- a structural fact fixed
    # before any upstream I/O happens, not a parsed status code -- so it
    # already carries the "FINAL attempt" meaning by construction (a
    # request that retries 502 then 200 inside @miss is still, and was
    # always going to be, an @miss request, i.e. MISS, regardless of how
    # many attempts that took upstream). This map's only remaining job is
    # to layer BYPASS on top of that truth for nocache=1 requests (ADR req
    # 3 / WP 3.10 item 3: SteamPrefill's nocache=1 speed probes are
    # bypass-INTENT, not a plain cache miss, and WP 3.11 needs to tell the
    # two apart without re-deriving $arg_nocache itself).
    #
    # "HIT:1" is unreachable under the current $vault_try_target logic
    # (nocache=1 always forces try_files onto a guaranteed-missing path, so
    # it can never resolve as a HIT) -- mapped anyway, defensively, in case
    # a future edit to the nocache bypass ever changes that, matching this
    # file's existing pattern of keeping defensive branches explicit rather
    # than relying on "can't currently happen" (see the /tmp/ location and
    # the store-path guard's 301/302 branch, both documented the same way
    # in core/README.md).
    map "$vault_cache_status:$arg_nocache" $vault_event_status {
        default   $vault_cache_status;
        "MISS:1"  BYPASS;
        "HIT:1"   BYPASS;
    }

    log_format vault_event escape=default
        'v1	$time_iso8601	$remote_addr	$vault_event_status	$vault_event_depot	$vault_event_uri	$bytes_sent	$host	$status';

    # Same log format/field names/order as the PoC (poc/conf/nginx.conf) --
    # deliberately unchanged so existing/future log analyzers built against
    # the Phase-0 format keep working against vault-core's production log.
    # UNCHANGED in the container too, on purpose: the container only changes
    # WHERE the lines go (stdout), never their shape.
    log_format vault
        '$time_local uri="$request_uri" status=$status '
        'range="$http_range" upstream_status=$vault_upstream_status '
        'bytes_sent=$bytes_sent request_time=$request_time '
        'cache=$vault_cache_status';

    # CONTAINER DELTA: stdout instead of logs/access.log. `docker logs` is the
    # single place both nginx logs appear, and the json-file driver's
    # max-size/max-file (deploy/compose.yaml) is what bounds them on disk.
    access_log  /dev/stdout  vault;

    server {
        # Steam CDN traffic is plain HTTP only. No other ports; no TLS here
        # (docs/PROJECT_PLAN.md section 10: only vault-api is ever meant to
        # be reachable remotely/behind TLS, never vault-core).
        listen       80;

        # Deliberately no server_name restriction: this server must answer
        # for whatever Host a redirected Steam client sends (that's the
        # entire point of DNS/hosts-file redirection). Host-based access
        # control happens via the allowlist maps above, inside @miss, not
        # via server_name/virtual-host matching.

        # Cache root: /vault/cache via the -p /vault prefix.
        root cache;
        # S3 fix: outside root, same filesystem as "cache/" -- see the temp
        # path comment above.
        proxy_temp_path tmp/proxy;

        # Default marker for anything outside /depot/ (health/heartbeat
        # endpoints below don't use proxy_store, so this value is never
        # read by those, but keeps the log format well-defined for them).
        set $vault_cache_status "-";

        location /depot/ {
            set $vault_cache_status HIT;

            # --- Request guards (pre-freeze project review S1, S2, P3) ------
            # Three `if` blocks, each containing ONLY a `return` -- the one
            # `if` pattern the nginx documentation calls safe (same rule as
            # the Host-allowlist `if` in @miss). They run in the rewrite
            # phase, i.e. BEFORE try_files, so a rejected request never
            # touches the disk or @miss. They sit after the `set` above on
            # purpose: a rejected request is logged with cache_status HIT
            # plus its 4xx/5xx status, which vault-api's sweeper filters on
            # HTTP status; a bare "-" there would be counted as a malformed
            # line instead.
            #
            # S1 -- self-proxy loop breaker. If a LAN router transparently
            # intercepts port 53 (DNAT to a Pi-hole/AdGuard that rewrites
            # *.steamcontent.com to THIS server), the `resolver` above no
            # longer reaches the real upstream resolver: @miss resolves the
            # edge hostname to vault-core's own address and proxy_pass dials
            # itself. Without this guard the recursion eats every worker
            # connection, proxy_next_upstream retries it three times over,
            # and HITs and /health fail with it. @miss stamps every
            # outbound request with X-SteamHangar-Hop: 1 (see there); a
            # request ARRIVING with that header can only be our own
            # proxied request coming back, so answer 508 Loop Detected
            # immediately. 508 is not in proxy_next_upstream's retry list
            # and the store guard only writes a 200, so the loop ends after
            # exactly one hop with nothing stored. 40-vault-preflight.sh
            # additionally probes the resolver at boot for this condition.
            if ($http_x_steamhangar_hop) {
                return 508;
            }
            # P3 -- GET only. Primary reason: @miss is a proxy_store path, and
            # a HEAD that misses would be relayed upstream and could store an
            # EMPTY object (a HEAD response has no body) under the chunk's
            # name; any other method would be relayed to Valve verbatim for
            # no reason. That depot traffic is GET-only is reasoned, not
            # measured (the PoC log_format never recorded the method): no
            # in-repo client issues anything but GET.
            if ($request_method != GET) {
                return 405;
            }
            # S2 -- no directory probing. try_files resolves a trailing-slash
            # URI against the DIRECTORY on disk: /depot/<id>/chunk/ answered
            # 403 (local, directory exists) once that depot had ever been
            # cached and an upstream 404 otherwise -- an unauthenticated
            # "is this depot cached here" oracle, contradicting the threat
            # model. No real depot object URI ends in "/", so refuse them all
            # locally with one answer, before try_files can look.
            if ($uri ~ /$) {
                return 404;
            }

            # ADR req 3: $vault_try_target is $uri normally, but resolves to
            # a guaranteed-nonexistent path when ?nocache=1 is present, so
            # nocache requests always fall through to @miss below.
            try_files $vault_try_target @miss;

            # WP 3.10 (ADR-0008): cache-event log for the HIT path -- see
            # the format spec and $vault_event_* maps above the server
            # block. Deliberately placed PER-LOCATION, not at server/http
            # level: /health, /lancache-heartbeat and /tmp/ below never
            # declare this directive at all, so they produce ZERO event-log
            # lines -- the cheapest possible "skip" for WP 3.11's sweeper,
            # not merely a typed/ignorable one. A request that try_files
            # resolves locally never reaches @miss, so only THIS access_log
            # fires for it -- nginx logs once, using the location that was
            # actually current when the request finished (an internal
            # redirect to @miss switches that location for the rest of the
            # request, including the log phase, so the two access_log
            # directives here and in @miss never double-log the same
            # request). buffer=/flush= reasoning: see @miss below.
            #
            # BLOCKER FIX (found empirically running this WP's own test
            # suite): nginx's access_log inheritance is REPLACE, not MERGE
            # -- a location that declares ANY access_log directive of its
            # own stops inheriting ALL access_log directives from parent
            # contexts, not just adds to them. Declaring only the event log
            # here silently killed the existing human-readable "vault" log
            # for every /depot/ request (it went from 2 log files to 1 for
            # this location, with no warning from nginx -- reproduced by
            # core/tests/test-core.ps1's own pre-existing smoke-test
            # assertions failing after this WP's first draft). The parent's
            # "vault" access_log MUST be re-stated explicitly at this level
            # to keep both logs alive here -- same fix applied in @miss.
            access_log /dev/stdout vault;
            #
            # CONTAINER DELTA (6th, see check-config-drift.sh): the path is
            # ${VAULT_EVENT_LOG}, rendered by envsubst -- empty/unset means
            # "feature off" (ADR-0008: optional at runtime), which envsubst
            # alone cannot turn into "no access_log directive at all"
            # (an empty substitution leaves a malformed directive, not a
            # clean no-op). /docker-entrypoint.d/25-vault-eventlog.sh runs
            # right after envsubst and removes this exact line (found via
            # the trailing marker comment, not by re-parsing the path) when
            # VAULT_EVENT_LOG is empty -- see that script for the full
            # reasoning. The marker itself is inert to nginx (a normal
            # trailing comment) and is stripped when the feature stays on.
            access_log ${VAULT_EVENT_LOG} vault_event buffer=64k flush=5s; # VAULT_EVENT_LOG_LINE
        }

        location @miss {
            set $vault_cache_status MISS;

            # WP 3.10 (ADR-0008): cache-event log for the MISS/BYPASS path
            # (see location /depot/ above for why this is duplicated here
            # instead of living at server/http level, the access_log
            # -inheritance-is-REPLACE blocker fix, and the CONTAINER DELTA /
            # toggle-script explanation).
            #
            # buffer=64k keeps this off the request's hot path: nginx
            # appends into the in-memory buffer and only issues a write()
            # syscall when the buffer fills OR flush=5s elapses since the
            # last flush, whichever comes first -- a depot request never
            # pays a synchronous log-write cost. Implication for WP 3.11's
            # sweeper: a line can sit unflushed in memory for up to 5
            # SECONDS after the request that produced it, so the sweeper's
            # cadence (WP 3.5, coarser than seconds) already tolerates this
            # trivially -- but a same-second "did the sweeper see this MISS
            # yet" test/expectation would be flaky; don't write one.
            access_log /dev/stdout vault;
            access_log ${VAULT_EVENT_LOG} vault_event buffer=64k flush=5s; # VAULT_EVENT_LOG_LINE

            # ADR req 4 abuse guard: refuse to proxy anywhere for a Host
            # that isn't a recognized Steam CDN family. This is the only
            # place in the config that can cause an outbound connection, so
            # this is where the allowlist must be enforced. (A HIT never
            # reaches here, so already-cached objects are served regardless
            # of Host -- that carries no open-proxy risk, see core/README.md.)
            #
            # Safe use of `if`: this location contains exactly one `if`
            # block whose only statement is `return`, with every other
            # directive below applying unconditionally otherwise -- the one
            # pattern the nginx documentation (wiki "IfIsEvil") calls safe.
            if ($vault_host_allowed = 0) {
                return 403;
            }

            proxy_http_version 1.1;
            proxy_set_header   Connection "";
            proxy_set_header   Host $vault_upstream_host;

            # S1 (pre-freeze review): mark every outbound request so that,
            # should DNS interception ever route it back to this server, the
            # guard in location /depot/ recognises it and answers 508 instead
            # of recursing. A real Steam CDN edge is expected to ignore the
            # header (unmeasured against the live CDN). Privacy cost: the
            # header goes upstream, in plain HTTP, on EVERY miss, so Valve and
            # any on-path observer can identify this cache as SteamHangar.
            proxy_set_header   X-SteamHangar-Hop "1";

            # ADR req 2: strip the client's own Range header before ever
            # forwarding to upstream. Setting a proxy_set_header value to
            # an empty string removes that header from the proxied request
            # entirely (documented nginx behavior) -- upstream always sees
            # a plain, rangeless GET on a miss, so it can never answer with
            # a 206 for supplying only part of the object. Combined with
            # the $vault_store_path 200-only guard above, this closes the
            # "proxy_store writes a truncated body under the full-object
            # path" corruption window described in docs/PROJECT_PLAN.md
            # section 9 and poc/RANGE-FINDINGS.md, even for a hypothetical
            # future CDN edge that *does* honor Range on a miss.
            proxy_set_header   Range "";

            # S2 fix (found in review): also strip Accept-Encoding and
            # If-Range before forwarding upstream.
            #   - Accept-Encoding: without this, upstream may answer with a
            #     gzip-compressed body (Content-Encoding: gzip) that gets
            #     proxy_store'd raw, byte-for-byte, onto disk. A later HIT
            #     serves that same file straight from disk via try_files --
            #     which does NOT know or re-add the Content-Encoding header,
            #     because nginx's static-file serving has no idea the bytes
            #     on disk were ever compressed. The client then receives a
            #     gzip body with no Content-Encoding header at all: silent,
            #     undetectable corruption (the depot chunk is unusable, but
            #     nothing in the HTTP exchange signals an error). Forcing
            #     Accept-Encoding to empty means upstream always answers
            #     identity (uncompressed), so the stored bytes and the
            #     served bytes agree.
            #   - If-Range: a conditional-range header only makes sense
            #     paired with a Range request; since Range is already
            #     stripped above, If-Range has no matching request left to
            #     qualify and would only add ambiguity for no benefit.
            proxy_set_header   Accept-Encoding "";
            proxy_set_header   If-Range "";

            # ADR req 4: short connect timeout + bounded retry across
            # resolver answers/upstream errors. Phase 0 observed a dead
            # upstream IP cause a real ~42s client-visible stall before a
            # 502 (poc/linux-client-test findings) -- this config trades
            # that for a fast, bounded failover instead.
            proxy_connect_timeout      3s;
            proxy_next_upstream        error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries  3;
            proxy_next_upstream_timeout 6s;

            proxy_pass http://$vault_upstream_host$request_uri;

            # ADR req 2: only a clean 200 ever gets written to disk -- see
            # the $vault_store_path map above and core/README.md for the
            # empirical verification of this guard.
            proxy_store        $vault_store_path;
            proxy_store_access user:rw group:r all:r;

            # WP TH-1a: cap the upstream READ of a miss (Steam -> vault). The
            # value is the per-request share of the operator's aggregate
            # VAULT_UPSTREAM_RATE (total / live $connections_writing), or 0 =
            # unlimited -- see the include above and core/README.md "Upstream
            # rate cap". Evaluated once per request, when the upstream
            # response headers arrive (TH-0b section 1.1). The client that
            # triggered the miss receives the chunk at the same pace: the
            # body streams through.
            #
            # proxy_limit_rate only acts on BUFFERED responses, and
            # proxy_store needs buffering too -- so buffering is stated
            # explicitly (it is nginx's default) and pinned by
            # check-config-drift.sh and the CI gate, and the upstream may
            # not switch it off per response with "X-Accel-Buffering: no"
            # (nginx honours that header by default; ignoring it is a
            # reasoned guard, not measured against a header-sending upstream).
            proxy_buffering      on;
            proxy_ignore_headers X-Accel-Buffering;
            proxy_limit_rate     $vault_upstream_rate;
        }

        # S3 defense-in-depth (found in review): temp files already live
        # outside "root" (see above), so no real request path resolves
        # under "cache/tmp/..." any more -- this location is a second,
        # independent layer of protection in case that ever changes again
        # (e.g. a future edit reintroduces a tmp dir under the cache root).
        # ^~ stops regex locations from matching underneath it.
        location ^~ /tmp/ {
            return 404;
        }

        location = /health {
            return 200 "ok\n";
        }

        # ADR req 1 / LanCache heartbeat contract (unchanged from the PoC,
        # confirmed required by SteamPrefill's own LancacheIpResolver.cs):
        # any LanCache-aware client (SteamPrefill, the Steam client itself)
        # GETs this before trusting an IP as a real cache and requires the
        # X-LanCache-Processed-By response header to be present.
        location = /lancache-heartbeat {
            add_header X-LanCache-Processed-By "steamhangar";
            return 200;
        }
    }
}
