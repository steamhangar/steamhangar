# Copy this file to .env and fill in real values. Never commit the real .env.

# Required. Shared secret clients send in the X-Api-Key header.
# No default on purpose — vault-api refuses to start without it. Generate a
# long random value, e.g.
#     openssl rand -base64 36
#     python -c "import secrets; print(secrets.token_urlsafe(36))"
# and paste it after the `=` below. Deliberately blank, not a placeholder: a
# copied-but-unedited file then fails loudly instead of booting with a key
# every reader of this public file already knows.
VAULT_API_KEY=

# Optional. Path to the SQLite database file.
VAULT_DB_PATH=./vault.db

# Optional. Root directory for the depot cache — the same directory vault-core
# stores into. vault-api diffs <VAULT_CACHE_ROOT>/depot/<depotid>/ before and
# after a prefill to learn which depots belong to which app.
# THIS IS ALSO THE DELETION BASE for DELETE /v1/cache/{appid}, so it is guarded:
# an empty value, a filesystem root (/, C:\, a bare UNC share) or a directory
# without a depot/ subdirectory makes deletion refuse with an error instead of
# removing anything. Relative paths are resolved against the process working
# directory — prefer an absolute path in production.
VAULT_CACHE_ROOT=./cache

# Optional. Log level: DEBUG, INFO, WARNING, ERROR.
VAULT_LOG_LEVEL=INFO

# Optional (required to actually RUN prefill jobs). Full path to the
# SteamPrefill executable. Unset = vault-api still starts and serves everything
# else; prefill jobs then fail with a clear message instead of the app refusing
# to boot. Log in once interactively before the first job:
#   SteamPrefill select-apps
# vault-api never handles Steam credentials — SteamPrefill keeps its own session
# in Config/ next to the executable. NOTE: vault-api overwrites
# Config/selectedAppsToPrefill.json on every job (that file is the only
# non-interactive way to select a specific app id).
VAULT_STEAMPREFILL_PATH=

# Optional. Hard time budget for a single SteamPrefill run, in seconds. This is
# a hang backstop, not a performance knob — a large game on a slow line
# legitimately takes hours. Default: 14400 (4 h).
VAULT_PREFILL_TIMEOUT_SECONDS=14400

# Optional. How long the job worker sleeps between polls of an empty queue,
# in seconds. Default: 1.0.
VAULT_WORKER_POLL_SECONDS=1.0

# Optional (WP S-1, ADR-0012). 'subprocess' (default — vault-api runs
# SteamPrefill itself, exactly as every version before this work package) or
# 'queue' (hand execution off to a separate `python -m vault_api.prefill_runner`
# process — see api/README.md "Queue mode"). Any other value is refused at
# startup. Leave this at 'subprocess' unless you are running a separate
# prefill_runner process/container pointed at the same VAULT_DB_PATH and
# VAULT_CACHE_ROOT.
VAULT_PREFILL_MODE=subprocess

# Optional, queue mode only. How often prefill_runner refreshes its lease
# while executing, and how stale that lease must be before vault-api's
# worker presumes the runner dead, both in seconds. Defaults: 5.0 / 30.0.
VAULT_RUNNER_HEARTBEAT_SECONDS=5.0
VAULT_RUNNER_LEASE_TIMEOUT_SECONDS=30.0

# Optional, prefill_runner only (set on that process/container's own
# environment, not vault-api's). How often prefill_runner polls for a job
# to claim when idle, in seconds. vault-api's worker uses
# VAULT_WORKER_POLL_SECONDS above for its own wait-on-hand-off loop -- this
# variable does not affect it. Default: 1.0.
VAULT_RUNNER_POLL_SECONDS=1.0

# Optional. TTL (seconds) for the in-process per-game size cache (plan §3:
# "du over depot folders, cached"). A disk walk over the whole depot/ tree
# costs real time on a large cache, so GET /v1/games and
# GET /v1/cache/summary reuse the last scan within this window. Invalidated
# immediately after a successful prefill job and after DELETE /v1/cache/{appid},
# so a game's size is never more than VAULT_SIZE_CACHE_TTL seconds stale for an
# idle cache, and is always fresh right after you fill or delete something.
# MUST BE > 0: vault-api refuses to start with 0 or a negative value. There is
# deliberately no "disable the cache" setting — a 0 would mean a full depot-tree
# walk on every single request, which is a footgun on a large cache, not a
# feature. Use a small value (e.g. 1) if you want near-live numbers.
# Default: 60.
VAULT_SIZE_CACHE_TTL=60

# Optional. How many agent report snapshots to keep per client_id
# (POST /v1/agent/installed). The agent posts its FULL installed list every
# ~30 minutes and vault-api stores one row per report, so without a cap the
# table would grow forever; older snapshots are pruned in the same transaction
# that writes a new one. 20 covers roughly the last 10 hours at the default
# reporting interval.
# MUST BE >= 2: the server-side diff (ADR-0002) needs the previous snapshot
# next to the one being written — with 1, every report would come back as a
# "first report" with no removals. vault-api refuses to start with a lower
# value. Only the newest snapshot is used for the diff; older ones are history.
# Default: 20.
VAULT_AGENT_REPORT_KEEP=20

# Optional. How many days a stored chunk is protected from garbage collection
# (POST /v1/cache/{appid}/gc), counted from its store time. MUST BE >= 0.
#
# WHAT THIS PROTECTS. GC decides what to delete by diffing the cache against
# the CURRENT manifests it knows about. Content that reached the cache only
# because a real client downloaded it through vault-core - an opt-in Steam BETA
# branch, a demo, a build vault-api never prefilled - appears in none of those
# manifests, so without this window the next collection would delete it and the
# client would re-download it. 14 days covers a normal beta/demo test cycle plus
# a weekend; a one-off download still ages out within a fortnight.
#
# HOW AGE IS MEASURED: the file's ctime (on Linux the inode change time, which
# vault-core's store-time rename sets; on Windows the creation time). NOT mtime
# - nginx proxy_store stamps mtime with Steam's publish date, which can be
# months before the file was actually stored, so an mtime-based window would
# protect nothing. A chunk whose age cannot be read at all is held back.
#
# 0 DISABLES the window: every orphan the plan names is deleted. Set that only
# if you never use beta branches and want every byte back immediately.
# The window never expands what GC deletes - it can only hold things back - and
# a dry run reports what it would hold back, with the reason, per chunk.
# Default: 14.
VAULT_GC_GRACE_DAYS=14

# ---------------------------------------------------------------------------
# Manifest oracle (WP 3.9) - OFF by default.
#
# READ THIS BEFORE ENABLING IT: this is the ONLY part of SteamHangar that talks
# to anything outside your LAN. With an oracle configured, vault-api makes
# outbound HTTPS requests to a THIRD PARTY (api.steamcmd.net by default - not
# affiliated with Valve and not run by this project) carrying the Steam APP ID
# it is asking about, i.e. which games this vault tracks and roughly when.
# Never sent: your API key, client ids, agent reports, cache contents, LAN
# addresses, or any Steam credentials (vault-api never has any).
#
# Nothing is queried automatically: a refresh happens only when something calls
# POST /v1/oracle/{appid}/refresh. There is no background polling to disable.
#
# WHAT YOU GET FOR IT:
#  - a pre-emptive "update available" badge between prefill runs, instead of
#    only learning a game is stale while a job is running;
#  - depot info for games that have never been cached;
#  - protection for OPT-IN BETA BRANCHES during garbage collection: their
#    chunks appear in no 'public' manifest, so without this they are only
#    protected for VAULT_GC_GRACE_DAYS days and are then collected. Oracle data
#    can only ADD to what GC keeps - it can never cause a deletion.
#
# Leave empty to disable (the default). The only supported value is
# 'steamcmd_api'; anything else is refused at startup.
VAULT_MANIFEST_ORACLE=

# Optional. Where the oracle asks: <base>/<appid>. Point this at your own
# mirror of the same API to keep the queries on your own network. Must be an
# http:// or https:// URL (validated at startup even while the oracle is off);
# redirects away from it are never followed, so the request cannot be handed
# to a host you did not configure.
# Default: https://api.steamcmd.net/v1/info
VAULT_MANIFEST_ORACLE_URL=https://api.steamcmd.net/v1/info

# Optional. Socket timeout for one oracle request, in seconds. MUST BE > 0.
# Short on purpose: the oracle is optional information and a slow third party
# must never become a slow vault-api. A timeout is an ordinary "no data"
# outcome - it never fails a job or blocks garbage collection.
# Default: 10.
VAULT_MANIFEST_ORACLE_TIMEOUT=10

# ---------------------------------------------------------------------------
# Scheduler (WP 3.5) - OFF by default.
# ---------------------------------------------------------------------------
# Optional. The daytime window in which vault-api keeps the gaming machines'
# installed games current on its own (plan A7/A8: the union of every client's
# latest agent report IS the prefill set).
#
# LEAVE THIS EMPTY TO DISABLE THE SCHEDULER - that is the default and the safe
# choice: with no window, vault-api only prefills when something asks it to
# (POST /v1/prefill). A fresh install should not start Steam logins and
# downloads on its own.
#
# Format: HH:MM-HH:MM, zero-padded, 24-hour, START INCLUSIVE / END EXCLUSIVE,
# in SERVER-LOCAL time (the machine's timezone, or the container's TZ).
#   09:00-17:00   daytime
#   22:00-06:00   overnight - supported, wraps past midnight (one contiguous
#                 night: 22:00 to midnight AND midnight to 06:00)
#   18:00-00:00   evening until midnight
#   00:00-24:00   always open ('24:00' is accepted as the END value only)
# Rejected at startup: an unpadded hour (9:00), a missing colon (0900-1700),
# an out-of-range hour/minute, '24:00' as the start, and start == end
# (ambiguous - use 00:00-24:00 for "always").
#
# All timestamps reported by GET /v1/schedule are UTC; only the window itself
# is local. Set TZ in your Compose file if the container's local time is not
# the one you mean.
VAULT_SCHEDULE_WINDOW=

# Optional. Minimum spacing between two sweeps, in minutes (plan §7 Phase 3's
# "every 3 h"). MUST BE > 0. A sweep enqueues one normal prefill job per target
# app; the single job worker then runs them strictly one at a time, which IS
# the spacing (ADR-0006: a non-forced run is a ~3 s no-op for an app that is
# already current, so a sweep over an unchanged library is cheap). The interval
# is measured from when the last sweep STARTED and is persisted in the
# database, so restarting vault-api mid-window does not trigger a fresh sweep.
# Default: 180.
VAULT_SCHEDULE_INTERVAL_MINUTES=180

# Optional. A client whose most recent agent report is older than this many
# days is left OUT of the sweep's target set. MUST BE > 0. Rationale: the
# target set is "what is installed on the gaming machines right now" - a
# machine that has been off for a week is not reporting anything right now, and
# keeping its last-known library current burns bandwidth and disk on a possibly
# decommissioned PC. Excluded clients are named in the log with the reason.
# Default: 7.
VAULT_SCHEDULE_CLIENT_STALE_DAYS=7

# Optional (WP 4d, plan Phase 4d "Sweep target set - installed PLUS cached").
# Widen the sweep's target set to ALSO include every app that holds content
# of its OWN on disk right now (a depot no other tracked app also maps - a
# depot SHARED with another app does not count, see api/README.md "Sweep
# target set" for why), not only the installed union above.
#
# ON BY DEFAULT since 2026-08-22 (WP SWEEP-1, docs/adr/0014-sweep-cached-and-
# auto-gc-default-on.md, operator decision) - was OFF through WP 4d. The cost
# is real and has not gone away: it spends bandwidth (checking) and, on real
# updates, disk (fresh chunks) on games nobody currently asked to have
# refreshed. It ships on anyway because it is no longer paired with nothing -
# see the GC coupling below.
#
# NOTE: this setting only does anything once the scheduler itself is running,
# i.e. once VAULT_SCHEDULE_WINDOW above is actually set - the daytime-window
# sweep is what evaluates this flag on each tick. Leaving VAULT_SCHEDULE_WINDOW
# empty (its own default) means this flag currently has NO EFFECT even at
# `true`, on this bare-metal/native path exactly as in the shipped container.
#
# WHY THIS IS CHEAP ENOUGH TO BE THE DEFAULT: a non-forced SteamPrefill run
# against an already-current app is a ~3 s no-op that transfers zero bytes
# (ADR-0006 decision 1) - real traffic only happens for apps that actually
# have an update. This is exactly what closes the gap
# VAULT_SCHEDULE_CLIENT_STALE_DAYS above opens: a game that is cached but
# currently installed nowhere - or whose only client has gone quiet longer
# than that setting - is invisible to the installed-only union and would
# otherwise never be refreshed again.
#
# READ THIS BEFORE DISABLING IT - THE GC COUPLING: every kept-current game
# this mode refreshes adds fresh chunks for the new manifest while the OLD
# manifest's chunks become orphans. This setting does not collect garbage, it
# only creates more of it to collect. A vault that keeps itself current
# without collecting garbage keeps itself current straight into a full disk -
# which is why VAULT_AUTO_GC (below) now defaults to 'execute' IN THE SAME
# CHANGE, not independently of it. Turning this on while VAULT_AUTO_GC is
# anything OTHER THAN 'execute' is still not refused - the operator may plan
# to run GC by hand instead - but it is never silent: vault-api logs a
# one-time WARNING on the transition into that combination (and a matching
# INFO all-clear on the way back out), and GET /v1/schedule's
# sweep_cached_gc_risk field exposes the same condition to a UI.
# IMPORTANT: 'dry-run' does NOT clear this condition - it only REPORTS what
# could be reclaimed and reclaims NOTHING, so a vault swept in dry-run mode
# grows at the identical speed to one with auto-GC fully off.
#
# Also settable at runtime via PATCH /v1/settings ("sweep_include_cached",
# ADR-0009) - see api/README.md "Persisted settings". Set this to `false`
# (together with VAULT_AUTO_GC=off below) to restore the pre-2026-08-22
# behaviour.
# Default: true.
VAULT_SWEEP_INCLUDE_CACHED=true

# ---------------------------------------------------------------------------
# Automatic garbage collection (WP 3.12) - defaults to execute since WP SWEEP-1.
# ---------------------------------------------------------------------------
# Optional. Should a prefill that actually UPDATED something automatically
# queue a garbage-collection job for that app? One of:
#
#   off       never. GC only runs when you ask for it
#             (POST /v1/cache/{appid}/gc). Default through WP 3.12.
#   dry-run   queue a REPORTING-ONLY GC job. Nothing is deleted; the job log
#             says what would be reclaimed. Use this to preview first.
#   execute   queue a GC job that DELETES the orphaned chunks it finds.
#             DEFAULT since 2026-08-22 (WP SWEEP-1, operator decision).
#
# WHY THE DEFAULT IS NOW execute, NOT off: this setting is PAIRED, in the same
# change, with VAULT_SWEEP_INCLUDE_CACHED above defaulting to 'true' - see
# docs/adr/0014-sweep-cached-and-auto-gc-default-on.md for the pairing
# argument. Shipping the cached-apps sweep on by default WITHOUT also
# shipping real collection on by default is exactly the "keeps itself current
# straight into a full disk" condition this project's own
# scheduler.cached_sweep_gc_risk warns about. Note this setting is NOT itself
# gated on the scheduler being enabled - see below.
#
# THIS SETTING APPLIES REGARDLESS OF WHETHER THE SCHEDULER RUNS: unlike
# VAULT_SWEEP_INCLUDE_CACHED above (which only matters once
# VAULT_SCHEDULE_WINDOW is set), auto-GC fires after ANY successful,
# update-producing prefill - a manual POST /v1/prefill, the "check & update"
# button, a miss-triggered prefill from the cache-event feed, or a scheduled
# sweep. With no scheduler window configured (this file's own default), the
# scheduled-sweep source is inert, but the other three are not - an operator
# who never touches VAULT_SCHEDULE_WINDOW still gets `execute`-mode GC
# running against every update those other paths produce.
#
# WHY ONLY AFTER AN UPDATE: orphans are what a game update leaves behind
# (chunks the new manifest no longer references). A run that only confirmed
# "still up to date" changed nothing, so there is nothing new to collect - and
# a routine staleness check must stay the ~3 s no-op it is designed to be
# instead of triggering a full depot scan. A failed, cancelled, paused or
# not-owned run never triggers it either: none of them tell you anything
# reliable about what is now orphaned.
#
# COMBINES WITH VAULT_GC_GRACE_DAYS: in 'execute' mode the grace window above
# still applies, so the chunks the prefill just stored are protected by their
# own store time and are not collected out from under the run that fetched
# them. (They are also in the current manifest, so GC would keep them anyway -
# the window is the belt to that suspenders.) THIS IS THE ONLY PROTECTION A
# LAN CLIENT'S store-on-miss / opt-in-beta-branch CONTENT HAS against an
# unattended execute run (ADR-0007's grace-window addendum): setting
# VAULT_GC_GRACE_DAYS=0 removes that protection entirely, and this pairing
# (VAULT_AUTO_GC=execute run unattended, immediately, by default) is the
# FIRST shipped configuration in which ADR-0007's known post-grace residual
# (content past the window, in no manifest this vault has recorded) can be
# collected without an operator ever asking for a GC run at all. Both known
# failure modes here are re-download-only, never corruption (ADR-0007) - but
# they are real, and VAULT_GC_GRACE_DAYS is what stands between unattended
# deletion and them.
#
# Dedupe applies: if a GC job for the same app in the same mode is already
# queued or running, the automatic one folds into it instead of stacking a
# second scan.
#
# Set this to 'off' (together with VAULT_SWEEP_INCLUDE_CACHED=false above) to
# restore the pre-2026-08-22 behaviour.
# Default: execute.
VAULT_AUTO_GC=execute

# ---------------------------------------------------------------------------
# Cache-event sweep (WP 3.11, ADR-0008) - OFF by default.
# ---------------------------------------------------------------------------
# Optional. Path to vault-core's STRUCTURED cache-event log (the second,
# machine-readable access_log vault-core writes when VAULT_EVENT_LOG is set on
# ITS side - see core/README.md "Cache-event log").
#
# LEAVE THIS EMPTY TO DISABLE THE WHOLE FEATURE - that is the default. With no
# path there are no per-client hit statistics, no bypass detection and no
# miss-triggered prefill; vault-core keeps serving and storing exactly as
# before either way (ADR-0008: the feed is optional at runtime, and the serving
# path never depends on vault-api being alive).
#
# READ THIS BEFORE SETTING IT: setting this path also ENABLES AUTOMATIC PREFILL
# DOWNLOADS ON CACHE MISSES - when a client downloads a game the cache does not
# have, vault-api queues a prefill job for it by itself. Set
# VAULT_MISS_TRIGGER_COOLDOWN_MINUTES=0 below to get the statistics and bypass
# detection without any automatic downloads.
#
# TWO SETTINGS ARE NEEDED, one per container. vault-core only WRITES the log
# when its own VAULT_EVENT_LOG is set (deploy/.env.example); this variable is
# the vault-api side that READS it. Setting only one of them does nothing.
#
# In a container deployment this is the path INSIDE the vault-api container.
# With the shipped Compose file both services already mount the same /vault
# volume and the core image pre-creates /vault/logs, so no extra volume is
# needed:
#   VAULT_EVENT_LOG_PATH=/vault/logs/event.log
#
# NOTE ON PERMISSIONS: vault-api runs as uid 101 while the log belongs to
# vault-core's nginx user, so vault-api can READ and sweep it but cannot
# ROTATE it. That is handled and not fatal - see VAULT_EVENT_LOG_MAX_BYTES.
VAULT_EVENT_LOG_PATH=

# Optional. Minutes between sweeps of that log. MUST BE > 0.
# Deliberately INDEPENDENT of VAULT_SCHEDULE_WINDOW: this sweeper owns the
# event log's rotation and feeds bypass detection, and both break if the log
# goes unread for the hours the window is shut. A sweep is one bounded read
# plus a few small database writes, so it is cheap enough to run around the
# clock. 5 minutes is comfortably coarser than vault-core's own 5-second log
# buffer flush, so no line is ever missed for being unflushed.
# Default: 5.
VAULT_EVENT_SWEEP_INTERVAL_MINUTES=5

# Optional. Per-app cooldown for MISS-TRIGGERED PREFILL, in minutes.
# MUST BE >= 0.
#
# WHAT THE TRIGGER IS (ADR-0001's hybrid decision): when a real client
# downloads a game through vault-core, the cache MISSes on chunks it does not
# have. If those chunks belong to a depot mapped to exactly one app that is not
# already cached-and-current, vault-api queues a normal (non-forced) prefill so
# one player's download completes the cache for everyone.
#
# 0 TURNS THE TRIGGER OFF - it does NOT mean "no cooldown". "No cooldown" is
# exactly the storm shape this setting exists to prevent, so it is not a value
# you can select. With 0, statistics and bypass detection keep working normally
# and nothing is ever enqueued from the event log.
#
# The trigger is ON by default whenever the sweep runs, because pointing
# VAULT_EVENT_LOG_PATH at the log IS the opt-in.
# Default: 60.
VAULT_MISS_TRIGGER_COOLDOWN_MINUTES=60

# Optional. Hard cap on how many prefill jobs ONE sweep may enqueue from
# misses. MUST BE > 0. The cooldown above bounds repeats for a single app;
# this bounds many DIFFERENT apps missing at once (a LAN party where six
# machines each start a different game). Candidates past the cap are named in
# the log and reconsidered on the next sweep - the cap delays, it never
# discards.
# Default: 5.
VAULT_MISS_TRIGGER_MAX_PER_SWEEP=5

# Optional. How many days of cache-log silence make a still-reporting client
# `bypass_suspected` in GET /v1/clients. MUST BE > 0.
#
# Detection fails toward NOT accusing: a client is flagged only if the feed is
# on, has been sweeping for at least this long, and the client reported
# installed games recently from a known address yet appears nowhere in the
# cache log within the window. A machine that has been off, has nothing
# installed, or whose reports predate the source-address column is never
# flagged.
#
# 3 days rather than 1 because Steam LAN peer-to-peer transfers can legitimately
# replace cache traffic (ADR-0001 production requirement 7), so a single quiet
# day is not evidence of a DNS/IPv6 bypass.
# Default: 3.
VAULT_BYPASS_WINDOW_DAYS=3

# Optional. How many per-sweep statistics rows to keep per client address.
# MUST BE > 0. The sweep writes one row per active address per sweep, so
# without a cap the table grows forever. CONSEQUENCE WORTH KNOWING: the
# cache_hits / bytes_served numbers in GET /v1/clients are sums over the
# RETAINED rows, so they are not lifetime totals and can go down over time.
# 48 rows at the default 5-minute interval is roughly the last 4 hours.
# Default: 48.
VAULT_CLIENT_STATS_KEEP=48

# Optional. Truncate the event log once it reaches this size, in bytes.
# MUST BE >= 0; 0 DISABLES truncation entirely.
#
# Per ADR-0008 the sweeper owns rotation: it truncates the file to zero and
# resets its cursor, but ONLY after a successful sweep and ONLY when every byte
# has been read. nginx opens the log with O_APPEND, so truncating under it is
# safe - the next line lands at offset 0 with no gap and no reopen needed.
#
# BEST-EFFORT, AND OFTEN NOT PERMITTED. In the shipped containers vault-api
# runs as uid 101 while the log belongs to vault-core's nginx user, so
# truncation fails with a permission error. That is handled, not fatal:
# sweeping is completely unaffected (correctness is cursor-based), a warning
# names the fix, and truncate_denied_count in GET /v1/stats climbs so the
# situation is visible. The fix is on the vault-core side - make the log
# writable by vault-api's uid (chown, or a shared group with 0664). Until then
# the file grows without bound. Set this to 0 if you rotate the log externally
# instead; the sweeper detects a shrunken file and restarts from offset 0.
# Default: 67108864 (64 MiB).
VAULT_EVENT_LOG_MAX_BYTES=67108864

# ---------------------------------------------------------------------------
# Generic webhook notifications (WP 3.13) - OFF by default.
# ---------------------------------------------------------------------------
# Optional. A URL vault-api POSTs a small generic JSON notification to when a
# job concludes (done/error/cancelled) or a client NEWLY looks like it is
# bypassing the cache. One stable schema for every receiver - no
# Discord/Slack/ntfy-specific templates; a receiver that wants a
# platform-native look adapts the generic JSON on its own side.
#
# LEAVE THIS EMPTY TO DISABLE THE WHOLE FEATURE - that is the default: no
# background thread, no queue, nothing built or sent.
#
# TRUST POSTURE: this URL is operator-supplied configuration, exactly like
# VAULT_STEAMPREFILL_PATH or VAULT_CACHE_ROOT - there is deliberately no
# allowlist and no SSRF protection (see api/README.md "Webhooks -> SSRF /
# trust posture"). Basic-auth userinfo embedded in the URL is still redacted
# from log lines.
VAULT_WEBHOOK_URL=

# Optional. Comma list of events to actually send. Unset/blank = all five.
# Valid names: job.done, job.error, job.cancelled, client.bypass_suspected,
# client.bypass_resolved. The last two are the two directions of the same
# bypass-detection flip - suspected is the alarm, resolved is the all-clear
# fired once cache-log presence returns for a previously-flagged client.
# An unknown name, or an empty entry (a stray comma), fails loudly at
# startup - the same house rule every other list/enum setting here follows.
# Default: all five.
VAULT_WEBHOOK_EVENTS=

# Optional. Per-attempt HTTP timeout for one delivery try, in seconds.
# MUST BE > 0. Delivery retries up to 3 times with a short backoff on its own
# background thread - this bounds a single attempt against a receiver that
# accepts the connection and then never responds. Never blocks the worker or
# the cache-event sweep; only the dedicated delivery thread can ever wait on
# it.
# Default: 5.
VAULT_WEBHOOK_TIMEOUT_SECONDS=5

# Optional. A label for this SteamHangar instance, carried as "vault_name" in
# every webhook payload. Omitted entirely (not sent as "") when unset. Purely
# cosmetic - useful if one receiver aggregates notifications from more than
# one instance. At most 64 characters after trimming surrounding whitespace,
# printable characters only; anything else refuses startup with a clear
# message (and is answered 422 on PATCH /v1/settings). Upgrade caveat: an
# existing name that is longer than 64 characters or contains a
# non-printable character such as a tab stops vault-api from booting until
# it is fixed.
VAULT_NAME=

# Optional. The SteamID64 whose library the web UI and the app show (WP
# API-FEAT-1). One per vault, so no device has to store its own. A public
# identifier, not a secret. Exactly 17 digits in the individual-account range
# (e.g. 76561197960287930); anything else refuses startup with a clear
# message (and is answered 422 on PATCH /v1/settings). Settable via PATCH
# /v1/settings too; this line is the readonly-deployment path.
# Default: none (not set).
#VAULT_STEAM_LIBRARY_STEAMID=

# ---------------------------------------------------------------------------
# Steam relay privacy gate (WP 4h.0, ADR-0010) - OFF by default.
# ---------------------------------------------------------------------------
# Optional. Whether GET /v1/steam/owned-games may include playtime_forever /
# rtime_last_played in its response AT ALL. Two independent switches, one per
# field, because "when did this person last play" is the sharper of the two
# facts - you may want the aggregate hour count for the decision-support
# panel while still refusing to ever surface the date.
#
# LEAVE BOTH UNSET/false FOR THE DEFAULT - a shared-household vault should
# not surface either without an explicit opt-in (docs/PROJECT_PLAN.md Phase
# 4h's privacy stance, user decision 2026-08-18). When a switch is off, the
# JSON key is OMITTED from the response entirely - not sent as 0/null, which
# a client (or anyone with a browser's dev tools open) could still read.
#
# ENVIRONMENT-ONLY, ON PURPOSE - NOT settable via PATCH /v1/settings, unlike
# most other booleans in this file (VAULT_SWEEP_INCLUDE_CACHED, VAULT_AUTO_GC).
# The settings table these would otherwise live in is stored in the vault-db
# Docker volume, which can be lost independently of this file (a
# `docker compose down -v`, a rebuild). For an ordinary tuning knob that is
# harmless; for a privacy opt-out, a lost override reverting to whatever the
# environment says could mean collection silently RESUMES with nobody
# notified. See docs/adr/0010-relay-privacy-gate-env-only.md for the full
# argument (and the alternative design this project considered and
# rejected). Changing either value means editing this file and restarting -
# there is no runtime switch.
# Default: false (both).
VAULT_RELAY_EXPOSE_PLAYTIME=false
VAULT_RELAY_EXPOSE_LAST_PLAYED=false

# ---------------------------------------------------------------------------
# Built-in web UI (WP 4a.1).
# ---------------------------------------------------------------------------
# Optional. Directory the static web UI (web/js, web/css, index.html) is
# served from. Leave empty for the default: a path computed relative to
# vault-api's own installation, which resolves to the real `web/` directory
# in a native checkout (api/README.md "Web UI static serving"). In the
# shipped Docker image this currently resolves to a path that does not
# exist - web/ is not yet copied into the image - and vault-api serves the
# API only, exactly as it always has, with a one-line log message. Point
# this at a populated web/ directory (e.g. a bind mount) to enable the UI
# in a container today, ahead of that packaging work landing.
VAULT_WEB_DIR=

# ---------------------------------------------------------------------------
# Persisted settings API (settings-API work package, ADR-0009).
# ---------------------------------------------------------------------------
# Optional. Locks PATCH /v1/settings entirely (403 for every request,
# regardless of body) while leaving GET /v1/settings working. Env-only, by
# definition: a flag that disables the settings-write API cannot itself be
# turned back on through that same API.
#
# LEAVE UNSET/0 FOR THE DEFAULT (read-write) - a fresh install gets the
# writable settings API described in api/README.md's "Persisted settings"
# section: vault name, schedule window/cadence, webhook URL/event filter and
# the auto-GC mode can all be changed at runtime via PATCH /v1/settings,
# overriding whatever this file (or the real environment) configures.
#
# SET TO 1 for a locked-down/GitOps deployment that wants the pre-ADR-0009
# pure-env posture: every setting comes from here (or the real environment)
# and nothing can change it without editing this file and restarting.
#
# Accepted: 1/true/yes/on (locked), 0/false/no/off/blank (writable),
# case-insensitive. Anything else is refused at startup.
VAULT_SETTINGS_READONLY=
